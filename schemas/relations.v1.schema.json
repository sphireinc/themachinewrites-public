{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themachinewrites.com/schemas/relations.v1.schema.json",
  "title": "The Machine Writes reverse relations v1",
  "$comment": "The publisher verifies that every backlink refers to an existing later canonical post and derives the index from related_ids and correction_of.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "relations"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "$ref": "latest-feed.v1.schema.json#/$defs/utcTimestamp" },
    "relations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "uniqueItems": true,
        "items": { "$ref": "latest-feed.v1.schema.json#/$defs/ulid" }
      }
    }
  }
}
